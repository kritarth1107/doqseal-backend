# ==================================================
# Server Configuration
# ==================================================
NODE_ENV=development
PORT=3030
API_VERSION=v1.0.0
CORS_ORIGINS=http://localhost:3000
LIVE_FRONTEND_URL=http://localhost:3000

# ==================================================
# Database Configuration
# ==================================================
MONGODB_URI=mongodb://localhost:27017/doqseal

# ==================================================
# Security Configuration
# ==================================================
JWT_SECRET=your_jwt_secret_key_here
JWT_VALIDITY=24h
AES_SECRET=your_aes_secret_key_here
# HMAC secret for API key verification (defaults to JWT_SECRET)
API_KEY_SIGNING_SECRET=

# ==================================================
# Email Configuration
# ==================================================
RESEND_API=your_resend_api_key
EMAIL_FROM=DoqSeal Security <security@mail.doqseal.com>

# ==================================================
# Logging Configuration
# ==================================================
LOG_LEVEL=info

# ==================================================
# Cache & Message Broker Configuration
# ==================================================
AMQP_URI=amqp://doqseal:doqseal@localhost:5672
EXTRACTION_QUEUE=extraction.jobs

# ==================================================
# File Storage
# ==================================================
STORAGE_ROOT=../storage

# ==================================================
# AI Engine (main-backend)
# ==================================================
AI_ENGINE_URL=http://localhost:3031

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=documents
ESIGN_ENABLED=false

# ==================================================
# Cashfree Payments (monthly subscription autopay)
# ==================================================
# Merchant Dashboard → Developers → API Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox
# HMAC secret for webhooks (defaults to CASHFREE_SECRET_KEY if empty)
CASHFREE_WEBHOOK_SECRET=
# cashfree | razorpay — defaults to razorpay when both are configured
BILLING_PROVIDER=razorpay

# ==================================================
# Razorpay Payments (monthly subscription autopay)
# ==================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Webhooks (defaults to RAZORPAY_KEY_SECRET)
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2025-01-01
